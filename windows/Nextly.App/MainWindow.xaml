<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Nextly.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nextly">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The app draws its own title bar, Fluent style; this strip drags the window. -->
        <Grid x:Name="AppTitleBar" Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/nextly-32.png" Width="16" Height="16" />
                <TextBlock Text="Nextly" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Ellipse x:Name="SyncDot" Width="8" Height="8" VerticalAlignment="Center" Margin="4,0,0,0" />
                <TextBlock x:Name="SyncText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="272"
            IsTitleBarAutoPaddingEnabled="False">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search (Ctrl+K)" QueryIcon="Find" />
            </NavigationView.AutoSuggestBox>

            <Grid x:Name="Body">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <ContentControl x:Name="ListHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <Border
                    x:Name="DetailHost"
                    Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0" />
                <InfoBar
                    x:Name="Toast"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,24"
                    IsOpen="False"
                    Severity="Informational" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
