<Project Sdk="Microsoft.NET.Sdk">

  <!-- Nextly's data, rules, lists and sync for the native Windows app.
       A port of the first app's app/src (on the tauri branch), like
       apple/NextlyKit for Swift; held to the same
       shared cases in spec/fixtures by Nextly.Core.Tests. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

</Project>
