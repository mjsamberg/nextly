# Shared secret every Nextly client sends as "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 32
NEXTLY_TOKEN=REPLACE_ME

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Docker.
# It's the long value after --token in the command Cloudflare shows you.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME

# Optional. Your time zone (default America/New_York), used for "today" when
# repeating tasks are finished from the widget or Siri.
# NEXTLY_TZ=America/New_York

# Optional: Incident IQ. Tickets assigned to you sync into an "Incident IQ"
# project, and comments, In Progress and finishing a task go back to IIQ.
# All three of these turn it on; see docs/incident-iq.md.
# IIQ_URL=https://chathamnc.incidentiq.com
# IIQ_SITE_ID=          (Administration > Developer Tools)
# IIQ_TOKEN=            (Administration > Developer Tools; your own API token)
# Your IIQ email. Only tickets assigned to you sync (admins see everyone's):
# IIQ_USER_EMAIL=
# Finishing a ticket's task posts this resolution action, which resolves it:
# IIQ_RESOLUTION_ACTION_ID=
# Only if the email lookup can't find you (the probe tells you):
# IIQ_USER_ID=
