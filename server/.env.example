# Shared secret every Nextly client sends as "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 32
NEXTLY_TOKEN=REPLACE_ME

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Docker.
# It's the long value after --token in the command Cloudflare shows you.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME
