{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: sync over http(s) and open links in the system browser",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*" }, { "url": "http://*:*" }, { "url": "https://*" }, { "url": "https://*:*" }]
    },
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "message:*" }]
    }
  ]
}
